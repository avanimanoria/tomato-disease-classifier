# Virtual environments
.venv/
venv/

# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# OS and editor files
.DS_Store
.vscode/
.idea/

# MATLAB temporary / autosave files
*.asv
*.autosave
*.m~
slprj/
codegen/

# Integration bridge transient mission runs and large logs
integration_bridge/io/mission_*
integration_bridge/logs/*.log
!integration_bridge/logs/.gitkeep
!integration_bridge/io/.gitkeep

# Software model datasets, archives, and model binary files
software_model/data/raw/
